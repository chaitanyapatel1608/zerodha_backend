NODE_ENV=development
PORT=3002
MONGO_URL=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<db_name>
JWT_SECRET=<replace-with-64-char-cryptographically-random-secret>
PUBLIC_FRONTEND_URL=http://localhost:3001
PUBLIC_BACKEND_URL=http://localhost:3002
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
EMAIL_SERVICE=gmail
EMAIL_USER=<sender-email>
EMAIL_PASS=<smtp-app-password>
